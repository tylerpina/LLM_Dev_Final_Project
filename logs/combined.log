}],"model":"gpt-4o-mini","temperature":0.2,"text":{"format":{"name":"response","schema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"sentiments":{"items":{"additionalProperties":false,"properties":{"emotions":{"description":"Detected emotions (e.g., optimism, concern, anger)","items":{"type":"string"},"type":"array"},"index":{"description":"Article index","type":"number"},"score":{"description":"Confidence score 0-1","maximum":1,"minimum":0,"type":"number"},"sentiment":{"description":"Overall sentiment","enum":["positive","negative","neutral"],"type":"string"}},"required":["index","sentiment","score","emotions"],"type":"object"},"type":"array"}},"required":["sentiments"],"type":"object"},"strict":false,"type":"json_schema"}}},"responseBody":"{\n  \"error\": {\n    \"message\": \"Incorrect API key provided: Sk-proj-********************************************************************************************************************************************************-SsA. You can find your API key at https://platform.openai.com/account/api-keys.\",\n    \"type\": \"invalid_request_error\",\n    \"param\": null,\n    \"code\": \"invalid_api_key\"\n  }\n}","responseHeaders":{"alt-svc":"h3=\":443\"; ma=86400","cf-cache-status":"DYNAMIC","cf-ray":"9a5dca8788e97ba7-LAX","connection":"keep-alive","content-length":"393","content-type":"application/json","date":"Fri, 28 Nov 2025 23:54:33 GMT","openai-processing-ms":"17","openai-version":"2020-10-01","server":"cloudflare","set-cookie":"_cfuvid=qGbSUSbGNFNNP60UaxHC_hQkSWl6PxcaWfIA9J4IQ34-1764374073600-0.0.1.1-604800000; path=/; domain=.api.openai.com; HttpOnly; Secure; SameSite=None","strict-transport-security":"max-age=31536000; includeSubDomains; preload","www-authenticate":"Bearer realm=\"OpenAI API\"","x-content-type-options":"nosniff","x-envoy-upstream-service-time":"19","x-request-id":"req_badafde13e244a46a8f2db164ac7aaae"},"statusCode":401,"url":"https://api.openai.com/v