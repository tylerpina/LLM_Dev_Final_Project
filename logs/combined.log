chema#","additionalProperties":false,"properties":{"sentiments":{"items":{"additionalProperties":false,"properties":{"emotions":{"description":"Detected emotions (e.g., optimism, concern, anger)","items":{"type":"string"},"type":"array"},"index":{"description":"Article index","type":"number"},"score":{"description":"Confidence score 0-1","maximum":1,"minimum":0,"type":"number"},"sentiment":{"description":"Overall sentiment","enum":["positive","negative","neutral"],"type":"string"}},"required":["index","sentiment","score","emotions"],"type":"object"},"type":"array"}},"required":["sentiments"],"type":"object"},"strict":false,"type":"json_schema"}}},"responseBody":"{\n  \"error\": {\n    \"message\": \"Incorrect API key provided: Sk-proj-********************************************************************************************************************************************************-SsA. You can find your API key at https://platform.openai.com/account/api-keys.\",\n    \"type\": \"invalid_request_error\",\n    \"param\": null,\n    \"code\": \"invalid_api_key\"\n  }\n}","responseHeaders":{"alt-svc":"h3=\":443\"; ma=86400","cf-cache-status":"DYNAMIC","cf-ray":"9a5dca884e765027-LAX","connection":"keep-alive","content-length":"393","content-type":"application/json","date":"Fri, 28 Nov 2025 23:54:33 GMT","openai-processing-ms":"12","openai-version":"2020-10-01","server":"cloudflare","set-cookie":"_cfuvid=E9XCc6npIO8NKRr7yuPUvArGpYd2FwXW_CLAHIB9tDQ-1764374073715-0.0.1.1-604800000; path=/; domain=.api.openai.com; HttpOnly; Secure; SameSite=None","strict-transport-security":"max-age=31536000; includeSubDomains; preload","www-authenticate":"Bearer realm=\"OpenAI API\"","x-content-type-options":"nosniff","x-envoy-upstream-service-time":"14","x-request-id":"req_93c5505d5e724bdea4cece64580a2d92"},"statusCode":401,"url":"https://api.openai.com/v1/responses"},"level":"error","message":"[sentiment] Failed to analyze sentiment batch","service":"llm-dev-project","timestamp":"2025