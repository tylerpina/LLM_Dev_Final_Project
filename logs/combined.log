{"error":{"data":{"error":{"code":"invalid_api_key","message":"Incorrect API key provided: Sk-proj-********************************************************************************************************************************************************-SsA. You can find your API key at https://platform.openai.com/account/api-keys.","param":null,"type":"invalid_request_error"}},"isRetryable":false,"name":"AI_APICallError","requestBodyValues":{"input":[{"content":[{"text":"Analyze the sentiment and emotional tone of these news articles.\n\nArticles:\n[0] Title: FP’s 2025 Holiday Gift Guide\nDescription: Treats and treasures from around the world.\n\n[1] Title: Peak Perspective: Reviewing Semifinalists for 2025 Awards\nDescription: Reviewing the Top Individuals from the Mountain West\n\n[2] Title: Marcus Semien surprised by trade to Mets but excited to play in New York\nDescription: A month ago, Marcus Semien was a father of four with three years left on a lucrative contract in Texas. Three weeks after he and his wife, Tarah, welcomed their fifth child, Semien was traded by the Rangers to the New York Mets on Monday for veteran outfielde…\n\n[3] Title: The Mail Day Thanksgiving Parade\nDescription: J.R. Fickle: Hello everyone and welcome to the Mail Day Thanksgiving Parade! We’re here in Irving, Texas — home of Panini! — where this parade is taking place.\n\n[4] Title: Meet the mastermind who helps shape Tennessee basketball's roster-building\nDescription: Scott Daughtry is on the Tennessee basketball staff as the director of strategy. He created an analytical model which helps the Vols build the roster.\n\nFor each article, determine:\n1. Sentiment: positive, negative, or neutral\n2. Confidence score (0-1)\n3. Emotional tones present (e.g., optimism, concern, excitement, anger, hope, fear)","type":"input_text"}],"role":"user"}],"model":"gpt-4o-mini","temperature":0.2,"text":{"format":{"name":"response","schema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"sentiments":{"items":{"additionalProperties":false,"properties":{"emotions":{"description":"Detected emotions (e.g., optimism, concern, anger)","items":{"type":"string"},"type":"array"},"index":{"description":"Article index","type":"number"},"score":{"description":"Confidence score 0-1","maximum":1,"minimum":0,"type":"number"},"sentiment":{"description":"Overall sentiment","enum":["positive","negative","neutral"],"type":"string"}},"required":["index","sentiment","score","emotions"],"type":"object"},"type":"array"}},"required":["sentiments"],"type":"object"},"strict":false,"type":"json_schema"}}},"responseBody":"{\n  \"error\": {\n    \"message\": \"Incorrect API key provided: Sk-proj-********************************************************************************************************************************************************-SsA. You can find your API key at https://platform.openai.com/account/api-keys.\",\n    \"type\": \"invalid_request_error\",\n    \"param\": null,\n    \"code\": \"invalid_api_key\"\n  }\n}","responseHeaders":{"alt-svc":"h3=\":443\"; ma=86400","cf-cache-status":"DYNAMIC","cf-ray":"9a5da98a5986b8d4-LAX","connection":"keep-alive","content-length":"393","content-type":"application/json","date":"Fri, 28 Nov 2025 23:32:02 GMT","openai-processing-ms":"18","openai-version":"2020-10-01","server":"cloudflare","set-cookie":"_cfuvid=9qq.dyQ5znFjwGe2PWSRzG.tXQaJXLYu8go4O1tLBW4-1764372722373-0.0.1.1-604800000; path=/; domain=.api.openai.com; HttpOnly; Secure; SameSite=None","strict-transport-security":"max-age=31536000; includeSubDomains; preload","www-authenticate":"Bearer realm=\"OpenAI API\"","x-content-type-options":"nosniff","x-envoy-upstream-service-time":"20","x-request-id":"req_199863b9f22847d2b1a876f49d9f6f09"},"statusCode":401,"url":"https://api.openai.com/v1/responses"},"level":"error","message":"[sentiment] Failed to analyze sentiment batch","service":"llm-dev-project","timestamp":"2025-11-28T23:32: